PORT=8080
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPERADMIN_EMAIL=owner@example.com

FRONTEND_URL=https://academy-frontend-wheat.vercel.app
BACKEND_URL=https://academy-backend-kqsv.onrender.com
CORS_ORIGINS=http://localhost:5173

# Botón de pago exclusivo para contratar licencias de Syncademia.
MERCADO_PAGO_PAYMENT_LINK=https://link.mercadopago.cl/smproweb

# Hardening operativo para instancias pequeñas.
JSON_BODY_LIMIT=10mb
MAX_LOGO_MB=5
API_RATE_LIMIT_MAX=300
SENSITIVE_RATE_LIMIT_MAX=30
REGISTRATION_RATE_LIMIT_MAX=10
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
EVOLUTION_TIMEOUT_MS=12000

# Comunicaciones opcionales.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Secreto aleatorio de al menos 32 caracteres. Evolution lo envía en un header privado.
WHATSAPP_WEBHOOK_SECRET=
