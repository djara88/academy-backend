{
  "name": "syncademia-backend",
  "version": "1.0.0",
  "description": "Backend multiacademia de Syncademia para gestión de academias deportivas",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint . --ext .js,.mjs --max-warnings 0",
    "build": "node --check server.js",
    "test": "node --test",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "academia",
    "futbol",
    "multi-tenant",
    "supabase"
  ],
  "author": "djara88",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "4.22.3",
    "multer": "2.4.0",
    "pdfkit": "^0.15.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "eslint": "8.57.1"
  }
}
