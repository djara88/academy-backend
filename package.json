{
  "name": "syncademia-backend",
  "version": "1.0.0",
  "description": "Backend multiacademia de Syncademia para gestión de academias deportivas",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint . --ext .js,.mjs --max-warnings 0",
    "build": "node --check server.js",
    "test": "node --test",
    "security:audit": "npm audit --omit=dev --audit-level=high && npm run tenant-security:audit && npm run admin-notification-security:audit && npm run supabase-phase2-security:audit && npm run rate-limit-security:audit && npm run import-atomic-security:audit && npm run phase3-idempotency:audit",
    "tenant-security:audit": "node scripts/tenant-security-audit.js",
    "admin-notification-security:audit": "node scripts/admin-notification-security-audit.js",
    "supabase:leaked-passwords:enable": "node scripts/enable-supabase-leaked-password-protection.mjs",
    "supabase:leaked-passwords:check": "node scripts/enable-supabase-leaked-password-protection.mjs --check",
    "supabase-phase2-security:audit": "node scripts/supabase-phase2-security-audit.js",
    "rate-limit-security:audit": "node scripts/rate-limit-security-audit.js",
    "import-atomic-security:audit": "node scripts/import-atomic-security-audit.js",
    "phase3-idempotency:audit": "node scripts/phase3-idempotency-audit.js"
  },
  "keywords": [
    "academia",
    "futbol",
    "multi-tenant",
    "supabase"
  ],
  "author": "djara88",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "4.22.3",
    "multer": "2.4.0",
    "pdfkit": "^0.15.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "eslint": "8.57.1"
  }
}
